{
  "name": "mindflow",
  "version": "1.0.1",
  "description": "AI-powered personal growth journal — diary, work log, and study notes in one place with AI reviews and knowledge base",
  "license": "AGPL-3.0",
  "author": {
    "name": "YUDongLin1",
    "email": "155050346+YUDongLin1@users.noreply.github.com",
    "url": "https://github.com/YUDongLin1"
  },
  "homepage": "https://github.com/YUDongLin1/MindFlow#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/YUDongLin1/MindFlow.git"
  },
  "bugs": {
    "url": "https://github.com/YUDongLin1/MindFlow/issues"
  },
  "keywords": [
    "journal",
    "diary",
    "mood-tracker",
    "habit-tracker",
    "productivity",
    "electron",
    "vue",
    "local-first",
    "offline",
    "privacy"
  ],
  "scripts": {
    "dev": "concurrently \"npm run vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:3000 npm run electron\"",
    "vite": "vite",
    "electron": "npm run --prefix electron start",
    "build": "vite build && npm run build-electron",
    "build-electron": "npm run --prefix electron build",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "preview": "vite preview",
    "serve": "vite serve",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vuepic/vue-datepicker": "^11.0.3",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "dompurify": "^3.3.0",
    "electron": "^33.0.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.0.4",
    "localforage": "^1.10.0",
    "lucide-vue-next": "^0.130.0",
    "pinia": "^4.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "terser": "^5.43.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vitest": "^3.2.4",
    "vue": "^3.5.10",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.4.5",
    "vue-tsc": "^3.1.2",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vuex": "^4.1.0"
  },
  "main": "electron/dist/main.js",
  "build": {
    "appId": "com.mindflow.app",
    "productName": "MindFlow",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "disableAsarIntegrity": true,
    "extraMetadata": {
      "main": "electron/dist/main.js"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json",
      "!electron/main.ts",
      "!electron/preload.ts",
      "!electron/tsconfig.json",
      "!src/**/*",
      "!scripts/**/*",
      "!docs/**/*",
      "!dist_old_*/**/*",
      "!**/*.map"
    ],
    "mac": {
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.lifestyle",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "mas": {
      "type": "distribution",
      "hardenedRuntime": false,
      "entitlements": "build-resources/entitlements.mas.plist",
      "entitlementsInherit": "build-resources/entitlements.mas.inherit.plist",
      "provisioningProfile": "build-resources/embedded.provisionprofile"
    },
    "extraResources": [
      {
        "from": "build-resources/windows-icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "MindFlow-Setup-${version}-${arch}.${ext}",
      "include": "build-resources/installer.nsh",
      "warningsAsErrors": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "MindFlow"
    },
    "linux": {
      "icon": "build-resources/linux-icons/icon-512.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
